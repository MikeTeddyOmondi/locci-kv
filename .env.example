# Locci KV — environment config
# Copy to .env and edit before running

# Bind on all interfaces: consumers are other containers and k8s pods, and
# 127.0.0.1 here would only be reachable from inside this container.
LOCCI_KV_BIND_ADDR=0.0.0.0:8080

# Where the data lives. MUST be a mounted volume — on k8s this is a 10Gi
# local-path PVC at /data. Without one, everything is lost with the container,
# and `local-path` is node-local so a rescheduled pod finds an empty volume.
LOCCI_KV_DATA_DIR=/data

LOCCI_KV_LOG_LEVEL=info

# ── for consumers, not this service ──────────────────────────────────────────
#
# Anything reading this store sets both, and both must be pinned:
#
#   LOCCI_KV_BACKEND=locci-kv   LOCCI_KV_URL=http://locci-kv:8080
#   LOCCI_KV_BACKEND=valkey     LOCCI_KV_URL=redis://valkey:6379
#
# These are DIFFERENT STORES holding different data. Omitting the backend falls
# back to a default, so a service reads an empty store while the real data sits
# untouched in the other one — which looks exactly like data loss and is not.
